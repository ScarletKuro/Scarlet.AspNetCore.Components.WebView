<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- ProjectReference consumers import these explicitly; NuGet consumers get them automatically. -->
  <Import Project="..\..\Win32Aot\build\Scarlet.AspNetCore.Components.WebView.Win32Aot.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Avalonia.BlazorApp</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Win32Aot\Microsoft.AspNetCore.Components.WebView.Win32Aot.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.*" />
  </ItemGroup>

  <Import Project="..\..\Win32Aot\build\Scarlet.AspNetCore.Components.WebView.Win32Aot.targets" />

</Project>
