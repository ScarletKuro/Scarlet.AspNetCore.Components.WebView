@page "/avalonia"
@implements IDisposable
@inject SharedCounter CounterState

<div class="integration-demo">
    <p class="eyebrow">BLAZOR HYBRID / WINDOWS</p>
    <h1>Blazor inside Avalonia</h1>
    <p>This is a local Razor component. There is no web server.</p>

    <section>
        <h2>Shared count: <span id="blazor-count">@CounterState.Count</span></h2>
        <p id="last-source">@CounterState.LastSource</p>
        <button class="btn" id="increment" @onclick="Increment">Send +1 to Avalonia</button>
    </section>

    <section>
        <h2>Threading</h2>
        <dl>
            <dt>UI thread</dt><dd>@Environment.CurrentManagedThreadId</dd>
            <dt>Synchronization context</dt><dd id="context">@_context</dd>
            <dt>Native AOT</dt><dd>@(System.Runtime.JitInfo.GetCompiledMethodCount() == 0 ? "Yes" : "No (JIT)")</dd>
        </dl>
        <p>Try the worker button in Avalonia. Its callback awaits a delay and then updates this component
            and the Avalonia controls on the same UI thread.</p>
    </section>

    <label for="typing">Keyboard focus test</label>
    <input id="typing" placeholder="Type here after clicking Focus Blazor" />
</div>

@code {
    private string _context = "";

    protected override void OnInitialized()
    {
        _context = SynchronizationContext.Current?.GetType().Name ?? "None";
        CounterState.SetIntegrationPageActive(true);
        CounterState.Changed += OnCounterChanged;
    }

    private void Increment() => CounterState.Increment("Blazor button through shared DI service");

    private void OnCounterChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CounterState.Changed -= OnCounterChanged;
        CounterState.SetIntegrationPageActive(false);
    }
}
